# --- String escapes & multiline ---
s = "line1\nline2"
print(s)
t = "tab\there"
print(t)
q = "quote: \"hi\""
print(q)
m = """first line
second line
third"""
print(m)

# --- Power, floor div, string repetition ---
print(2 ** 10)
print(7 // 2)
print("ab" * 3)
print(3 * "ab")

# --- String comparisons ---
print("abc" < "abd")
print("b" > "a")
print("abc" == "abc")
print("abc" != "abd")

# --- Negative list indexing ---
nums = [10, 20, 30, 40]
print(nums[-1])
print(nums[-2])
nums[-1] = 99
print(nums)

# --- Slicing ---
print(nums[1:3])
print(nums[:2])
print(nums[1:])
print(nums[::2])
print(nums[::-1])
print("hello"[1:4])
print("hello"[::-1])

# --- in operator ---
print(2 in nums)
print(100 in nums)
print("ell" in "hello")
print("z" in "hello")
d = {"a": 1, "b": 2}
print("a" in d)
print("c" in d)

# --- Ternary ---
x = 5
print(x > 3 ? "big" : "small")
print(x > 10 ? "big" : "small")

# --- Multiple assignment & return ---
a, b = 1, 2
print(a)
print(b)
a, b = b, a
print(a)
print(b)

func swap(x, y)
    return y, x
end

p, q = swap(1, 2)
print(p)
print(q)

# --- Tuples ---
tup = (1, 2, 3)
print(tup)

# --- Default parameters ---
func greet(name, greeting = "Hello", punct = "!")
    return greeting + " " + name + punct
end

print(greet("Alice"))
print(greet("Bob", "Hi"))
print(greet("Carol", "Hey", "?"))

# --- foreach ---
fruits = ["apple", "banana", "cherry"]
for f in fruits
    print(f)
end

for c in "xyz"
    print(c)
end

for k in d
    print(k)
end

# --- range ---
for i in range(3)
    print(i)
end

for i in range(1, 5)
    print(i)
end

for i in range(0, 10, 2)
    print(i)
end

# --- compound assignment ---
n = 10
n *= 2
print(n)
n /= 4
print(n)
n %= 3
print(n)
n **= 3
print(n)
n //= 2
print(n)
