# --- String escapes & multiline ---
s = "line1\nline2"
say(s)
t = "tab\there"
say(t)
q = "quote: \"hi\""
say(q)
m = """first line
second line
third"""
say(m)

# --- Power, floor div, string repetition ---
say(2 ** 10)
say(7 // 2)
say("ab" * 3)
say(3 * "ab")

# --- String comparisons ---
say("abc" < "abd")
say("b" > "a")
say("abc" == "abc")
say("abc" != "abd")

# --- Negative list indexing ---
nums = [10, 20, 30, 40]
say(nums[-1])
say(nums[-2])
nums[-1] = 99
say(nums)

# --- Slicing ---
say(nums[1:3])
say(nums[:2])
say(nums[1:])
say(nums[::2])
say(nums[::-1])
say("hello"[1:4])
say("hello"[::-1])

# --- of operator ---
say(2 of nums)
say(100 of nums)
say("ell" of "hello")
say("z" of "hello")
d = {"a": 1, "b": 2}
say("a" of d)
say("c" of d)

# --- Ternary ---
x = 5
say(x > 3 ? "big" : "small")
say(x > 10 ? "big" : "small")

# --- Multiple assignment & return ---
a, b = 1, 2
say(a)
say(b)
a, b = b, a
say(a)
say(b)

func swap(x, y)
    return y, x
end

p, q = swap(1, 2)
say(p)
say(q)

# --- Tuples ---
tup = (1, 2, 3)
say(tup)

# --- Default parameters ---
func greet(name, greeting = "Hello", punct = "!")
    return greeting + " " + name + punct
end

say(greet("Alice"))
say(greet("Bob", "Hi"))
say(greet("Carol", "Hey", "?"))

# --- foreach ---
fruits = ["apple", "banana", "cherry"]
for f of fruits
    say(f)
end

for c of "xyz"
    say(c)
end

for k of d
    say(k)
end

# --- range ---
for i of range(3)
    say(i)
end

for i of range(1, 5)
    say(i)
end

for i of range(0, 10, 2)
    say(i)
end

# --- compound assignment ---
n = 10
n *= 2
say(n)
n /= 4
say(n)
n %= 3
say(n)
n **= 3
say(n)
n //= 2
say(n)


