# Test try/catch/finally
say("--- Finally: no error ---")
try
    say("try body")
finally
    say("finally body")
end
say("after")

say("--- Finally: error caught ---")
try
    say("try body 2")
    throw "boom"
catch e
    say("caught: " + e)
finally
    say("finally body 2")
end
say("after 2")

say("--- Finally: error not caught ---")
try
    say("try body 3")
    throw "unhandled"
finally
    say("finally body 3")
end
say("unreachable")


