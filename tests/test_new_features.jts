# Test break/continue
say("--- Break/Continue ---")
i = 0
while i < 10
    i = i + 1
    if i == 3
        continue
    end
    if i == 7
        break
    end
    say(i)
end

# Test elif
say("--- Elif ---")
x = 15
if x < 10
    say("small")
elif x < 20
    say("medium")
elif x < 30
    say("big")
else
    say("huge")
end

# Test += / -=
say("--- Compound Assignment ---")
a = 10
a += 5
say(a)
a -= 3
say(a)

# Test try/catch/throw
say("--- Try/Catch/Throw ---")
try
    throw "Something went wrong!"
catch e
    say("Caught: " + e)
end

# Test string methods
say("--- String Methods ---")
s = "hello world"
say(s.upper())
say(s.lower())
say(s.trim())
say(s.contains("world"))
say(s.replace("world", "JTS"))
say(s.substring(0, 5))
say(s.starts_with("hello"))
say(s.ends_with("world"))

# Test dictionary
say("--- Dictionary ---")
d = {"name": "JTS", "version": "2.0"}
say(d)
say(d["name"])

# Test list methods
say("--- List Methods ---")
lst = [3, 1, 2]
lst.sort()
say(lst)
lst.remove(2)
say(lst)
lst.pop()
say(lst)

# Test file I/O
say("--- File I/O ---")
write_file("test_output.txt", "Hello from JTS!")
content = read_file("test_output.txt")
say(content)

say("--- All tests passed! ---")

