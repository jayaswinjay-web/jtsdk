# List comprehension tests
print("--- basic ---")
squares = [x * x for x in range(1, 6)]
print(squares)

evens = [x for x in range(10) if x % 2 == 0]
print(evens)

names = ["alice", "bob", "carol"]
upper = [n.upper() for n in names]
print(upper)

nums = [1, 2, 3, 4, 5]
doubled = [n * 2 for n in nums]
print(doubled)

neg = [-3, -1, 0, 2, 4]
pos = [x for x in neg if x > 0]
print(pos)

word = "hello"
chars = [c + c for c in word]
print(chars)

print([i * 10 for i in range(3)])

print("--- in try ---")
try
    x = [n for n in range(4)]
    print(x)
catch e
    print("caught")
end

total = sum([n for n in range(100) if n % 5 == 0])
print(total)

print("--- nested ---")
nested = [[a for a in range(b)] for b in range(1, 4)]
print(nested)

func build(max)
    return [x * 3 for x in range(max)]
end

print(build(4))

d = {"k1": 10, "k2": 20, "k3": 30}
print([v for v in d.values()])
print([k for k in d.keys()])
