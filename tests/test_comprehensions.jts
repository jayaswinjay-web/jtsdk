# List comprehension tests
say("--- basic ---")
squares = [x * x for x of range(1, 6)]
say(squares)

evens = [x for x of range(10) if x % 2 == 0]
say(evens)

names = ["alice", "bob", "carol"]
upper = [n.upper() for n of names]
say(upper)

nums = [1, 2, 3, 4, 5]
doubled = [n * 2 for n of nums]
say(doubled)

neg = [-3, -1, 0, 2, 4]
pos = [x for x of neg if x > 0]
say(pos)

word = "hello"
chars = [c + c for c of word]
say(chars)

say([i * 10 for i of range(3)])

say("--- of try ---")
try
    x = [n for n of range(4)]
    say(x)
catch e
    say("caught")
end

total = sum([n for n of range(100) if n % 5 == 0])
say(total)

say("--- nested ---")
nested = [[a for a of range(b)] for b of range(1, 4)]
say(nested)

func build(max)
    return [x * 3 for x of range(max)]
end

say(build(4))

d = {"k1": 10, "k2": 20, "k3": 30}
say([v for v of d.values()])
say([k for k of d.keys()])


