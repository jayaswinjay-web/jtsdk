# Test the standard library scrolls
bring math
bring strings
bring lists
bring random
bring json
bring os
bring time

# --- math ---
say("--- math ---")
say("math.sin(0) = ", math.sin(0))
say("math.cos(0) = ", math.cos(0))
say("math.pi = ", math.pi)
say("math.tau = ", math.tau)
say("math.clamp(15, 0, 10) = ", math.clamp(15, 0, 10))
say("math.factorial(5) = ", math.factorial(5))
say("math.gcd(48, 36) = ", math.gcd(48, 36))
say("math.lcm(4, 6) = ", math.lcm(4, 6))
say("math.is_prime(7) = ", math.is_prime(7))
say("math.is_prime(8) = ", math.is_prime(8))
say("math.sign(-3) = ", math.sign(-3))
say("math.is_even(10) = ", math.is_even(10))
say("math.digit_sum(12345) = ", math.digit_sum(12345))

# --- strings ---
say("--- strings ---")
say("strings.reverse('hello') = ", strings.reverse("hello"))
say("strings.is_palindrome('racecar') = ", strings.is_palindrome("racecar"))
say("strings.count_words('the quick brown fox') = ", strings.count_words("the quick brown fox"))
say("strings.repeat('ab', 3) = ", strings.repeat("ab", 3))
say("strings.truncate('a very long string', 8) = ", strings.truncate("a very long string", 8))
say("strings.capitalize_words('hello world jts') = ", strings.capitalize_words("hello world jts"))
say("strings.strip_vowels('hello') = ", strings.strip_vowels("hello"))

# --- lists ---
say("--- lists ---")
say("lists.flatten([1, [2, 3], [4, [5, 6]]]) = ", lists.flatten([1, [2, 3], [4, [5, 6]]]))
say("lists.unique([1, 2, 2, 3, 3, 3]) = ", lists.unique([1, 2, 2, 3, 3, 3]))
say("lists.reversed([1, 2, 3, 4]) = ", lists.reversed([1, 2, 3, 4]))
say("lists.chunk([1, 2, 3, 4, 5], 2) = ", lists.chunk([1, 2, 3, 4, 5], 2))
say("lists.rotate([1, 2, 3, 4, 5], 2) = ", lists.rotate([1, 2, 3, 4, 5], 2))
say("lists.median([1, 2, 3, 4]) = ", lists.median([1, 2, 3, 4]))
say("lists.first([9, 8, 7]) = ", lists.first([9, 8, 7]))
say("lists.last([9, 8, 7]) = ", lists.last([9, 8, 7]))
say("lists.sum_squares([1, 2, 3]) = ", lists.sum_squares([1, 2, 3]))
say("lists.count_occurrences([1, 2, 1, 3, 1], 1) = ", lists.count_occurrences([1, 2, 1, 3, 1], 1))

# --- random ---
say("--- random ---")
r1 = random.random()
say("random.random() of [0, 1) = ", r1 >= 0 and r1 < 1)
say("random.int_between(1, 10) = ", random.int_between(1, 10))
say("random.choice(['a', 'b', 'c']) = ", random.choice(["a", "b", "c"]))
say("random.coin_flip() = ", random.coin_flip())

# --- json ---
say("--- json ---")
parsed = json.parse('{"name": "JTS", "year": 2026}')
say("json.parse name = ", parsed["name"])
say("json.parse year = ", parsed["year"])
say("json.stringify = ", json.stringify({"a": 1, "b": [2, 3]}))

# --- os ---
say("--- os ---")
say("os.file_exists('test_os.txt') = ", os.file_exists("test_os.txt"))
os.file_write("test_os.txt", "hello os")
say("os.file_exists('test_os.txt') = ", os.file_exists("test_os.txt"))
say("os.file_read('test_os.txt') = ", os.file_read("test_os.txt"))

# --- time ---
say("--- time ---")
say("len(time.today()) = ", len(time.today()))
say("len(time.clock_time()) = ", len(time.clock_time()))
say("time.epoch() is string = ", type(time.epoch()) == "string")

say("--- All stdlib tests passed! ---")


