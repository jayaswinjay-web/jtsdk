# Test the standard library scrolls
bring math
bring strings
bring lists
bring random
bring json
bring os
bring time

# --- math ---
print("--- math ---")
print("math.sin(0) = ", math.sin(0))
print("math.cos(0) = ", math.cos(0))
print("math.pi = ", math.pi)
print("math.tau = ", math.tau)
print("math.clamp(15, 0, 10) = ", math.clamp(15, 0, 10))
print("math.factorial(5) = ", math.factorial(5))
print("math.gcd(48, 36) = ", math.gcd(48, 36))
print("math.lcm(4, 6) = ", math.lcm(4, 6))
print("math.is_prime(7) = ", math.is_prime(7))
print("math.is_prime(8) = ", math.is_prime(8))
print("math.sign(-3) = ", math.sign(-3))
print("math.is_even(10) = ", math.is_even(10))
print("math.digit_sum(12345) = ", math.digit_sum(12345))

# --- strings ---
print("--- strings ---")
print("strings.reverse('hello') = ", strings.reverse("hello"))
print("strings.is_palindrome('racecar') = ", strings.is_palindrome("racecar"))
print("strings.count_words('the quick brown fox') = ", strings.count_words("the quick brown fox"))
print("strings.repeat('ab', 3) = ", strings.repeat("ab", 3))
print("strings.truncate('a very long string', 8) = ", strings.truncate("a very long string", 8))
print("strings.capitalize_words('hello world jts') = ", strings.capitalize_words("hello world jts"))
print("strings.strip_vowels('hello') = ", strings.strip_vowels("hello"))

# --- lists ---
print("--- lists ---")
print("lists.flatten([1, [2, 3], [4, [5, 6]]]) = ", lists.flatten([1, [2, 3], [4, [5, 6]]]))
print("lists.unique([1, 2, 2, 3, 3, 3]) = ", lists.unique([1, 2, 2, 3, 3, 3]))
print("lists.reversed([1, 2, 3, 4]) = ", lists.reversed([1, 2, 3, 4]))
print("lists.chunk([1, 2, 3, 4, 5], 2) = ", lists.chunk([1, 2, 3, 4, 5], 2))
print("lists.rotate([1, 2, 3, 4, 5], 2) = ", lists.rotate([1, 2, 3, 4, 5], 2))
print("lists.median([1, 2, 3, 4]) = ", lists.median([1, 2, 3, 4]))
print("lists.first([9, 8, 7]) = ", lists.first([9, 8, 7]))
print("lists.last([9, 8, 7]) = ", lists.last([9, 8, 7]))
print("lists.sum_squares([1, 2, 3]) = ", lists.sum_squares([1, 2, 3]))
print("lists.count_occurrences([1, 2, 1, 3, 1], 1) = ", lists.count_occurrences([1, 2, 1, 3, 1], 1))

# --- random ---
print("--- random ---")
r1 = random.random()
print("random.random() in [0, 1) = ", r1 >= 0 and r1 < 1)
print("random.int_between(1, 10) = ", random.int_between(1, 10))
print("random.choice(['a', 'b', 'c']) = ", random.choice(["a", "b", "c"]))
print("random.coin_flip() = ", random.coin_flip())

# --- json ---
print("--- json ---")
parsed = json.parse('{"name": "JTS", "year": 2026}')
print("json.parse name = ", parsed["name"])
print("json.parse year = ", parsed["year"])
print("json.stringify = ", json.stringify({"a": 1, "b": [2, 3]}))

# --- os ---
print("--- os ---")
print("os.file_exists('test_os.txt') = ", os.file_exists("test_os.txt"))
os.file_write("test_os.txt", "hello os")
print("os.file_exists('test_os.txt') = ", os.file_exists("test_os.txt"))
print("os.file_read('test_os.txt') = ", os.file_read("test_os.txt"))

# --- time ---
print("--- time ---")
print("len(time.today()) = ", len(time.today()))
print("len(time.clock_time()) = ", len(time.clock_time()))
print("time.epoch() is string = ", type(time.epoch()) == "string")

print("--- All stdlib tests passed! ---")
