# Extended try/finally tests
func run_cleanup(ok)
    try
        if ok
            throw "inner failure"
        end
        say("no failure")
    catch e
        say("caught: " + e)
    finally
        say("cleanup running")
    end
    say("function done")
end

run_cleanup(true)
run_cleanup(false)

say("--- nested try/finally ---")
try
    try
        throw "deep"
    catch e
        say("inner caught: " + e)
    finally
        say("inner finally")
    end
finally
    say("outer finally")
end
say("after nested")

say("--- finally with locals ---")
try
    x = 10
    y = x * 2
    throw "local err"
catch e
    say("err: " + e)
finally
    say("x+y=" + (x + y))
end


