# --- Math ---
say(abs(-5))
say(min(3, 1, 2))
say(max(3, 1, 2))
say(min([4, 2, 9]))
say(max([4, 2, 9]))
say(sum([1, 2, 3, 4]))
say(pow(2, 10))
say(round(3.14159, 2))
say(round(2.5))
say(floor(3.7))
say(ceil(3.2))
say(pi)
say(e)

# --- Conversions ---
say(int("42"))
say(int(3.9))
say(int(true))
say(float("2.5"))
say(bool(0))
say(bool(1))
say(bool(""))

# --- String methods ---
s = "Hello World"
say(s.find("World"))
say(s.find("xyz"))
say(s.count("l"))
say("hello".capitalize())
say("hello world".title())
say("Hello".swapcase())
say("123".is_digit())
say("abc".is_alpha())
say("abc123".is_alnum())
say("   ".is_space())
say("ABC".is_upper())
say("abc".is_lower())
say("42".zfill(5))
say("hi".ljust(5, "*"))
say("hi".rjust(5, "*"))
say("hi".center(5, "*"))
say("-".join(["a", "b", "c"]))
say("  hi  ".lstrip())
say("  hi  ".rstrip())
say("a\nb\nc".splitlines())
say("Hello {}, you are {}!".format("Bob", 30))
say("Hello {1} and {0}".format("A", "B"))

# --- List methods ---
lst = [1, 2, 3]
lst.insert(1, 99)
say(lst)
lst2 = [4, 5]
lst.extend(lst2)
say(lst)
say(lst.count(99))
say(lst.index(5))
say(lst.index(999))
lst.reverse()
say(lst)
cop = lst.copy()
cop.append(100)
say(lst)
say(cop)
lst.clear()
say(lst)

# --- Dict methods ---
d = {"a": 1, "b": 2, "c": 3}
say(d.keys())
say(d.values())
say(d.items())
say(d.get("a"))
say(d.get("zzz"))
say(d.get("zzz", -1))
say(d.has("b"))
say(d.has("zzz"))
d2 = {"d": 4}
d.update(d2)
say(d)
say(d.pop("b"))
say(d)
d.clear()
say(d)

# --- JSON ---
data = json_parse('{"name": "Bob", "age": 30, "tags": ["x", "y"], "ok": true}')
say(data["name"])
say(data["age"])
say(data["tags"])
say(data["ok"])
s = json_stringify({"a": 1, "b": "hi", "c": [1, 2], "d": void})
say(s)

# --- Time ---
t = now()
say(t > 1700000000)
say(strftime("%Y"))

# --- OS ---
say(cwd() != void)
say(env("PATH") != void)
say(args())

# --- Random ---
seed(42)
r = rand()
say(r >= 0 and r < 1)
ri = randint(1, 6)
say(ri >= 1 and ri <= 6)


