# Closures regression test

# Basic capture (read-only)
func make_adder(x)
    func add(y)
        return x + y
    end
    return add
end

add5 = make_adder(5)
print(add5(10))    # 15
print(add5(100))   # 105

# Independent state via object mutation
func make_counter()
    state = []
    func increment()
        state.append(len(state))
        return len(state)
    end
    return increment
end

c1 = make_counter()
print(c1())       # 1
print(c1())       # 2
print(c1())       # 3
c2 = make_counter()
print(c2())       # 1
print(c1())       # 4

# Nested closures (3 levels)
func triple()
    a = 1
    b = 2
    func mid()
        func inner()
            return a + b
        end
        return inner
    end
    return mid
end

t = triple()
inner = t()
print(inner())    # 3

# Closure capturing a parameter
func multiplier(factor)
    func mul(n)
        return factor * n
    end
    return mul
end

double = multiplier(2)
triple_m = multiplier(3)
print(double(21))    # 42
print(triple_m(14))  # 42
