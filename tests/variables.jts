# Variables and data types

# Numbers
age = 25
price = 19.99
negative = -10

say("Age: " + age)
say("Price: " + price)
say("Negative: " + negative)

# Strings
name = "JTS GO"
language = "Programming Language"
say(name)
say(language)

# Booleans
is_active = true
is_new = false
say(is_active)
say(is_new)

# void
result = void
say(result)

# Type checking
say(type(age))
say(type(name))
say(type(is_active))


