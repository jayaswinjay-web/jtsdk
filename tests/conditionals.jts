# Control flow - if/else

temperature = 75

if temperature > 80
    say("It's hot outside!")
else
    say("It's nice outside!")
end

# Grading system
score = 85

if score >= 90
    say("Grade: A")
else if score >= 80
    say("Grade: B")
else if score >= 70
    say("Grade: C")
else if score >= 60
    say("Grade: D")
else
    say("Grade: F")
end

# Nested if
age = 25
has_ticket = true

if age >= 18
    if has_ticket
        say("Entry allowed")
    else
        say("Need a ticket")
    end
else
    say("Must be 18 or older")
end


