# Arithmetic operations

a = 10
b = 3

say("a = " + a)
say("b = " + b)
say("a + b = " + (a + b))
say("a - b = " + (a - b))
say("a * b = " + (a * b))
say("a / b = " + (a / b))
say("a % b = " + (a % b))

# Operator precedence
say("(a + b) * 2 = " + ((a + b) * 2))
say("a + b * 2 = " + (a + b * 2))

# Unary minus
x = -5
say("x = " + x)
say("-x = " + (-x))


