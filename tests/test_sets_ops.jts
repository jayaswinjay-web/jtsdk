print("Bitwise:")
print(5 & 3)
print(5 | 3)
print(5 ^ 3)
print(~5)
print(1 << 4)
print(256 >> 2)
a = 6
a |= 1
print(a)
b = 7
b &= 3
print(b)
c = 5
c ^= 3
print(c)
d = 2
d <<= 3
print(d)
e = 64
e >>= 2
print(e)

print("Is:")
print(1 is 1)
print(1 is 2)
print("a" is "a")

print("Assert:")
assert 1 + 1 == 2
assert 5 > 3, "five bigger"
print("asserts ok")

print("Del:")
x = 10
del x
lst = [1, 2, 3, 4]
del lst[1]
print(lst)
dct = {"a": 1, "b": 2, "c": 3}
del dct["b"]
print(dct)
print(len(dct))

print("Sets:")
s = {1, 2, 3, 2, 1}
print(s)
print(len(s))
print(2 in s)
print(9 in s)
t = set([4, 5, 6])
print(t)
print(s | t)
print(s & set([2, 3, 4]))
print(s - set([1]))
print(s ^ set([2, 7]))
print(set_add(s, 7))
print(7 in s)
print(set_contains(s, 7))
print(set_remove(s, 3))
print(3 in s)
s2 = set("abc")
print(s2)
print(type(s) == "set")
print(type(s2))
print(len(s2))
for item in s
    print("item: " + item)
end
