say("Bitwise:")
say(5 & 3)
say(5 | 3)
say(5 ^ 3)
say(~5)
say(1 << 4)
say(256 >> 2)
a = 6
a |= 1
say(a)
b = 7
b &= 3
say(b)
c = 5
c ^= 3
say(c)
d = 2
d <<= 3
say(d)
e = 64
e >>= 2
say(e)

say("Is:")
say(1 is 1)
say(1 is 2)
say("a" is "a")

say("Assert:")
assert 1 + 1 == 2
assert 5 > 3, "five bigger"
say("asserts ok")

say("Del:")
x = 10
del x
lst = [1, 2, 3, 4]
del lst[1]
say(lst)
dct = {"a": 1, "b": 2, "c": 3}
del dct["b"]
say(dct)
say(len(dct))

say("Sets:")
s = {1, 2, 3, 2, 1}
say(s)
say(len(s))
say(2 of s)
say(9 of s)
t = set([4, 5, 6])
say(t)
say(s | t)
say(s & set([2, 3, 4]))
say(s - set([1]))
say(s ^ set([2, 7]))
say(set_add(s, 7))
say(7 of s)
say(set_contains(s, 7))
say(set_remove(s, 3))
say(3 of s)
s2 = set("abc")
say(s2)
say(type(s) == "set")
say(type(s2))
say(len(s2))
for item of s
    say("item: " + item)
end


