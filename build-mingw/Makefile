	$(MAKE) $(MAKESILENT) -f CMakeFiles\jtsc.dir\build.make CMakeFiles/jtsc.dir/src/vm/vm.c.i
	$(MAKE) $(MAKESILENT) -f CMakeFiles\jtsvm.dir\build.make CMakeFiles/jtsvm.dir/src/vm/vm.c.i
	$(MAKE) $(MAKESILENT) -f CMakeFiles\jts.dir\build.make CMakeFiles/jts.dir/src/vm/vm.c.i
.PHONY : src/vm/vm.c.i

src/vm/vm.s: src/vm/vm.c.s
.PHONY : src/vm/vm.s

# target to generate assembly for a file
src/vm/vm.c.s:
	$(MAKE) $(MAKESILENT) -f CMakeFiles\jtsc.dir\build.make CMakeFiles/jtsc.dir/src/vm/vm.c.s
	$(MAKE) $(MAKESILENT) -f CMakeFiles\jtsvm.dir\build.make CMakeFiles/jtsvm.dir/src/vm/vm.c.s
	$(MAKE) $(MAKESILENT) -f CMakeFiles\jts.dir\build.make CMakeFiles/jts.dir/src/vm/vm.c.s
.PHONY : src/vm/vm.c.s

