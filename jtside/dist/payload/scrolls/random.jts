# random scroll - random helpers (wraps builtin rand/randint/seed/shuffle)
func random()
    return rand()
end

func int_between(a, b)
    return randint(a, b)
end

func choice(lst)
    n = len(lst)
    if n == 0
        return void
    end
    return lst[randint(0, n - 1)]
end

func choices(lst, count)
    out = []
    i = 0
    while i < count
        out.append(choice(lst))
        i = i + 1
    end
    return out
end

func sample(lst, count)
    copy = lst.copy()
    copy.shuffle()
    out = []
    i = 0
    while i < count and i < len(copy)
        out.append(copy[i])
        i = i + 1
    end
    return out
end

func coin_flip()
    return rand() > 0.5
end

