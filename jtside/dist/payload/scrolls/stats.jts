# stats scroll - statistics helpers
func mean(data)
    if len(data) == 0
        return 0
    end
    return sum(data) / len(data)
end

func median(data)
    n = len(data)
    if n == 0
        return 0
    end
    arr = data.copy()
    arr.sort()
    mid = n // 2
    if n % 2 == 0
        return (arr[mid - 1] + arr[mid]) / 2.0
    end
    return arr[mid]
end

func mode(data)
    best = void
    best_count = 0
    i = 0
    while i < len(data)
        item = data[i]
        c = 0
        j = 0
        while j < len(data)
            if data[j] == item
                c = c + 1
            end
            j = j + 1
        end
        if c > best_count
            best_count = c
            best = item
        end
        i = i + 1
    end
    return best
end

func population_variance(data)
    n = len(data)
    if n == 0
        return 0
    end
    m = mean(data)
    total = 0.0
    for x of data
        d = x - m
        total = total + d * d
    end
    return total / n
end

func sample_variance(data)
    n = len(data)
    if n <= 1
        return 0
    end
    return population_variance(data) * n / (n - 1)
end

func variance(data, is_sample)
    if is_sample
        return sample_variance(data)
    end
    return population_variance(data)
end

func population_stdev(data)
    return sqrt(population_variance(data))
end

func sample_stdev(data)
    return sqrt(sample_variance(data))
end

func stdev(data)
    return sample_stdev(data)
end

func weighted_mean(values, weights)
    num = 0.0
    den = 0.0
    i = 0
    while i < len(values)
        num = num + values[i] * weights[i]
        den = den + weights[i]
        i = i + 1
    end
    if den == 0
        return 0
    end
    return num / den
end

func geometric_mean(data)
    n = len(data)
    if n == 0
        return 0
    end
    p = 1.0
    for x of data
        p = p * x
    end
    return pow(p, 1.0 / n)
end

func harmonic_mean(data)
    n = len(data)
    total = 0.0
    for x of data
        total = total + 1.0 / x
    end
    if total == 0
        return 0
    end
    return n / total
end

func range_stat(data)
    if len(data) == 0
        return 0
    end
    return max(data) - min(data)
end

func midrange(data)
    if len(data) == 0
        return 0
    end
    return (max(data) + min(data)) / 2.0
end

func percentile(data, p)
    n = len(data)
    if n == 0
        return 0
    end
    arr = data.copy()
    arr.sort()
    if p <= 0
        return arr[0]
    end
    if p >= 100
        return arr[n - 1]
    end
    rank = p / 100.0 * (n - 1)
    lo = floor(rank)
    hi = ceil(rank)
    if lo == hi
        return arr[int(lo)]
    end
    frac = rank - lo
    return arr[int(lo)] * (1 - frac) + arr[int(hi)] * frac
end

func quartile1(data)
    return percentile(data, 25)
end

func quartile3(data)
    return percentile(data, 75)
end

func interquartile_range(data)
    return quartile3(data) - quartile1(data)
end

func zscore(x, data)
    m = mean(data)
    sd = population_stdev(data)
    if sd == 0
        return 0
    end
    return (x - m) / sd
end

func standardize(data)
    m = mean(data)
    sd = population_stdev(data)
    out = []
    for x of data
        if sd == 0
            out.append(0)
        else
            out.append((x - m) / sd)
        end
    end
    return out
end

func normalize(data)
    n = len(data)
    if n == 0
        return []
    end
    lo = min(data)
    hi = max(data)
    out = []
    if hi == lo
        for x of data
            out.append(0.5)
        end
        return out
    end
    for x of data
        out.append((x - lo) / (hi - lo))
    end
    return out
end

func mean_absolute_deviation(data)
    m = mean(data)
    total = 0.0
    for x of data
        total = total + abs(x - m)
    end
    return total / len(data)
end

func covariance(xs, ys)
    n = len(xs)
    if n == 0
        return 0
    end
    mx = mean(xs)
    my = mean(ys)
    total = 0.0
    i = 0
    while i < n
        total = total + (xs[i] - mx) * (ys[i] - my)
        i = i + 1
    end
    return total / n
end

func correlation(xs, ys)
    sx = population_stdev(xs)
    sy = population_stdev(ys)
    if sx == 0 or sy == 0
        return 0
    end
    return covariance(xs, ys) / (sx * sy)
end

func trim_mean(data, fraction)
    arr = data.copy()
    arr.sort()
    n = len(arr)
    if n == 0
        return 0
    end
    k = floor(n * fraction)
    if k * 2 >= n
        return mean(arr)
    end
    out = []
    i = k
    while i < n - k
        out.append(arr[i])
        i = i + 1
    end
    return mean(out)
end

