# math scroll - standard math library
pi = 3.141592653589793
e = 2.718281828459045
tau = 6.283185307179586
phi = 1.618033988749895
sqrt2 = 1.4142135623730951

func log2(x)
    return log(x) / log(2.0)
end

func log10(x)
    return log(x) / log(10.0)
end

func hypot(a, b)
    return sqrt(a * a + b * b)
end

func degrees(r)
    return r * 180.0 / pi
end

func radians(d)
    return d * pi / 180.0
end

func sign(x)
    if x > 0
        return 1
    end
    if x < 0
        return -1
    end
    return 0
end

func clamp(x, lo, hi)
    if x < lo
        return lo
    end
    if x > hi
        return hi
    end
    return x
end

func lerp(a, b, t)
    return a + (b - a) * t
end

func is_even(n)
    return n % 2 == 0
end

func is_odd(n)
    return n % 2 != 0
end

func factorial(n)
    if n <= 1
        return 1
    end
    return n * factorial(n - 1)
end

func gcd(a, b)
    while b != 0
        t = b
        b = a % b
        a = t
    end
    return a
end

func lcm(a, b)
    return a // gcd(a, b) * b
end

func is_prime(n)
    if n < 2
        return false
    end
    if n == 2
        return true
    end
    if n % 2 == 0
        return false
    end
    i = 3
    while i * i <= n
        if n % i == 0
            return false
        end
        i = i + 2
    end
    return true
end

func avg(numbers)
    return sum(numbers) / len(numbers)
end

func midpoint(a, b)
    return (a + b) / 2.0
end

func digit_sum(n)
    total = 0
    while n > 0
        total = total + n % 10
        n = n // 10
    end
    return total
end
