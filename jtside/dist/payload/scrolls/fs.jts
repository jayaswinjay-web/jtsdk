# fs scroll - file system helpers
func exists(path)
    return file_exists(path)
end

func read(path)
    return read_file(path)
end

func write(path, text)
    return write_file(path, text)
end

func append_text(path, text)
    if file_exists(path)
        return write_file(path, read_file(path) + text)
    end
    return write_file(path, text)
end

func read_lines(path)
    lines = read_file(path).splitlines()
    if len(lines) > 0 and lines[len(lines) - 1] == ""
        lines.pop()
    end
    return lines
end

func write_lines(path, lines)
    return write_file(path, "\n".join(lines))
end

func count_lines(path)
    return len(read_lines(path))
end

func first_line(path)
    lines = read_lines(path)
    return lines[0]
end

func last_line(path)
    lines = read_lines(path)
    return lines[len(lines) - 1]
end

func file_size(path)
    return len(read_file(path))
end

func is_empty_file(path)
    return file_size(path) == 0
end

func basename(path)
    i = len(path) - 1
    while i >= 0
        c = path[i]
        if c == "/" or c == "\\"
            return path.substring(i + 1, len(path))
        end
        i = i - 1
    end
    return path
end

func dirname(path)
    i = len(path) - 1
    while i >= 0
        c = path[i]
        if c == "/" or c == "\\"
            if i == 0
                return "/"
            end
            return path.substring(0, i)
        end
        i = i - 1
    end
    return "."
end

func ext(path)
    i = len(path) - 1
    while i >= 0
        c = path[i]
        if c == "."
            return path.substring(i, len(path))
        end
        if c == "/" or c == "\\"
            return ""
        end
        i = i - 1
    end
    return ""
end

func join_path(a, b)
    if a == ""
        return b
    end
    if b == ""
        return a
    end
    if a.ends_with("/") or a.ends_with("\\")
        return a + b
    end
    return a + "/" + b
end

func with_extension(path, new_ext)
    e = ext(path)
    if e == ""
        return path + new_ext
    end
    return path.substring(0, len(path) - len(e)) + new_ext
end

func copy_text(src, dst)
    return write_file(dst, read_file(src))
end

func word_count(path)
    n = 0
    for line of read_lines(path)
        words = line.split(" ")
        for w of words
            if w != ""
                n = n + 1
            end
        end
    end
    return n
end

