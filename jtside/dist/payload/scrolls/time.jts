# time scroll - time helpers
func sleep_ms(ms)
    sleep(ms / 1000.0)
end

func epoch()
    return strftime("%s")
end

func stamp()
    return strftime("%Y-%m-%d %H:%M:%S")
end

func stamp_utc()
    return strftime("%Y-%m-%dT%H:%M:%SZ")
end

func today()
    return strftime("%Y-%m-%d")
end

func clock_time()
    return strftime("%H:%M:%S")
end

