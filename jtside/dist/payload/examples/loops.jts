# Loops - while and for

# While loop - count 0 to 4
say("While loop:")
count = 0
while count < 5
    say(count)
    count = count + 1
end

# Countdown
say("Countdown:")
n = 5
while n > 0
    say(n)
    n = n - 1
end
say("Liftoff!")

# For loop - count 0 to 9
say("For loop:")
for i of 0 to 10
    say(i)
end

# Multiplication table
say("5x table:")
for i of 1 to 11
    say("5 x " + i + " = " + (5 * i))
end
