# Minimal Neural Network in JTS GO
# A 2-3-1 multi-layer perceptron trained on XOR with gradient descent.
# Uses the built-in AI/ML functions: sigmoid(), mse(), seed(), rand().

# ---------- dataset (XOR) ----------
inputs  = [[0, 0], [0, 1], [1, 0], [1, 1]]
targets = [[0], [1], [1], [0]]

n_in = 2
n_hidden = 3
n_out = 1
lr = 1.0
n_samples = len(inputs)

# ---------- helpers ----------
func init_layer(rows, cols)
    layer = []
    for r of 0 to rows
        row = []
        for c of 0 to cols
            append(row, rand() - 0.5)
        end
        append(layer, row)
    end
    return layer
end

# Last row of each layer is the bias weights (bias input is always 1).
w1 = init_layer(n_in + 1, n_hidden)
w2 = init_layer(n_hidden + 1, n_out)

# ---------- forward pass ----------
func forward(x)
    a1 = []
    for j of 0 to n_hidden
        z = w1[n_in][j]
        for i of 0 to n_in
            z = z + x[i] * w1[i][j]
        end
        append(a1, sigmoid(z))
    end

    z = w2[n_hidden][0]
    for j of 0 to n_hidden
        z = z + a1[j] * w2[j][0]
    end
    out = sigmoid(z)
    return [out, a1]
end

# ---------- training ----------
func train(epochs)
    for e of 0 to epochs
        total_loss = 0
        for s of 0 to n_samples
            x = inputs[s]
            t = targets[s][0]

            f = forward(x)
            out = f[0]
            a1 = f[1]

            diff = out - t
            total_loss = total_loss + diff * diff

            d_out = diff * out * (1 - out)
            d_a1 = []
            for j of 0 to n_hidden
                append(d_a1, d_out * w2[j][0])
            end

            w2[n_hidden][0] = w2[n_hidden][0] - lr * d_out
            for j of 0 to n_hidden
                w2[j][0] = w2[j][0] - lr * d_out * a1[j]
            end

            for j of 0 to n_hidden
                dz1 = d_a1[j] * a1[j] * (1 - a1[j])
                w1[n_in][j] = w1[n_in][j] - lr * dz1
                for i of 0 to n_in
                    w1[i][j] = w1[i][j] - lr * dz1 * x[i]
                end
            end
        end

        if e % 500 == 0
            say("epoch " + e + "   loss " + round(total_loss / 4 * 1000) / 1000)
        end
    end
end

# ---------- test ----------
train(5000)

say("--- Trained network on XOR ---")
preds = []
for s of 0 to n_samples
    out = forward(inputs[s])[0]
    append(preds, out)
    say(str(inputs[s]) + "  ->  " + round(out * 1000) / 1000 + "   (target " + targets[s][0] + ")")
end

target_list = [0, 1, 1, 0]
say("final MSE: " + round(mse(preds, target_list) * 1000) / 1000)
