# JTS Chat — a minimal LLM you can talk to.
# A character-level trigram model trained on a small corpus.
# It learns P(next char | previous two chars), then answers by
# continuing your last two characters with freshly generated text.
# (It's a character model, so answers sound like word-salad.)

corpus = "hello how are you today. i am fine thank you. what is your name. my name is jts. jts go is a programming language. i love learning to code. the weather is nice today. tell me a story. once upon a time there was a little fox. the fox jumped over the lazy dog. machines can learn to talk. this is a tiny language model. it learns from the words that you write. goodbye and have a nice day. the quick brown fox jumps high."

contexts = []
nexts = []
freqs = []

# ---------- learn ----------
ctx = "  "
for i in 0 to len(corpus)
    c = substring(corpus, i, i + 1)

    ci = -1
    for j in 0 to len(contexts)
        if contexts[j] == ctx
            ci = j
        end
    end
    if ci == -1
        append(contexts, ctx)
        append(nexts, [])
        append(freqs, [])
        ci = len(contexts) - 1
    end

    ni = -1
    for j in 0 to len(nexts[ci])
        if nexts[ci][j] == c
            ni = j
        end
    end
    if ni == -1
        append(nexts[ci], c)
        append(freqs[ci], 1)
    else
        freqs[ci][ni] = freqs[ci][ni] + 1
    end

    ctx = substring(ctx, 1, 2) + c
end

print("learned " + len(contexts) + " contexts")

# ---------- helpers ----------
func find_context(ctx)
    for j in 0 to len(contexts)
        if contexts[j] == ctx
            return j
        end
    end
    return -1
end

func sample(ci)
    total = 0
    for j in 0 to len(freqs[ci])
        total = total + freqs[ci][j]
    end
    r = rand() * total
    acc = 0
    for j in 0 to len(freqs[ci])
        acc = acc + freqs[ci][j]
        if r < acc
            return nexts[ci][j]
        end
    end
    return nexts[ci][0]
end

func generate(start, length)
    ctx = "  "
    if len(start) >= 2
        ctx = substring(start, len(start) - 2, len(start))
    end
    out = ""
    for i in 0 to length
        ci = find_context(ctx)
        c = " "
        if ci != -1
            c = sample(ci)
        end
        out = out + c
        ctx = substring(ctx, 1, 2) + c
    end
    return out
end

# ---------- chat ----------
seed(1)
print("JTS Chat: type a message (or 'exit' to quit)")
while true
    msg = input("you> ")
    if msg == "exit"
        break
    end
    print("llm> " + generate(msg, 80))
end
print("bye!")
