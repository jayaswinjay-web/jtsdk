<Application x:Class="JtsIde.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>

    <!-- ================= palette ================= -->
    <SolidColorBrush x:Key="Bg.Window" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="Bg.Panel" Color="#252526"/>
    <SolidColorBrush x:Key="Bg.Editor" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="Bg.Tab" Color="#2D2D30"/>
    <SolidColorBrush x:Key="Bg.Hover" Color="#3E3E42"/>
    <SolidColorBrush x:Key="Bg.Border" Color="#3F3F46"/>
    <SolidColorBrush x:Key="Bg.Selected" Color="#094771"/>
    <SolidColorBrush x:Key="Bg.Button" Color="#3C3C3C"/>
    <SolidColorBrush x:Key="Bg.ButtonHover" Color="#505050"/>
    <SolidColorBrush x:Key="Fg.Text" Color="#D4D4D4"/>
    <SolidColorBrush x:Key="Fg.Muted" Color="#9DA5B4"/>

    <!-- ================= base text ================= -->
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Fg.Text}"/>
    </Style>

    <!-- ================= menu ================= -->
    <Style TargetType="Menu">
      <Setter Property="Background" Value="{StaticResource Bg.Panel}"/>
      <Setter Property="Foreground" Value="{StaticResource Fg.Text}"/>
      <Setter Property="Grid.IsSharedSizeScope" Value="True"/>
    </Style>

    <Style TargetType="MenuItem">
      <Setter Property="Foreground" Value="{StaticResource Fg.Text}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="MenuItem">
            <Grid Background="Transparent">
              <Border x:Name="Bg" Background="Transparent" Margin="0">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="IconCol"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="GestureCol"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <ContentPresenter ContentSource="Icon" VerticalAlignment="Center" Margin="6,0,4,0"/>
                  <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True"
                                    VerticalAlignment="Center" Margin="8,4,16,4"/>
                  <TextBlock Grid.Column="2" x:Name="Gesture"
                             Text="{TemplateBinding InputGestureText}"
                             Foreground="{StaticResource Fg.Muted}"
                             VerticalAlignment="Center" Margin="16,0,8,0"/>
                  <Path Grid.Column="3" x:Name="Arrow"
                        Data="M 4,0 L 10,6 L 4,12 Z"
                        Fill="{StaticResource Fg.Muted}" Width="10" Height="12"
                        Stretch="Fill" VerticalAlignment="Center" Margin="2,0,8,0"
                        Visibility="Collapsed"/>
                </Grid>
              </Border>
              <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom"
                     IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
                <Border Background="{StaticResource Bg.Panel}"
                        BorderBrush="{StaticResource Bg.Border}" BorderThickness="1"
                        Padding="2" Margin="0,2,0,0">
                  <ScrollViewer MaxHeight="520" VerticalScrollBarVisibility="Auto">
                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="Role" Value="TopLevelHeader">
                <Setter TargetName="PART_Popup" Property="Placement" Value="Bottom"/>
                <Setter TargetName="PART_Popup" Property="HorizontalOffset" Value="-4"/>
              </Trigger>
              <Trigger Property="Role" Value="SubmenuHeader">
                <Setter TargetName="PART_Popup" Property="Placement" Value="Right"/>
                <Setter TargetName="PART_Popup" Property="HorizontalOffset" Value="-2"/>
                <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{StaticResource Bg.Hover}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="Separator">
      <Setter Property="Background" Value="{StaticResource Bg.Border}"/>
      <Setter Property="Foreground" Value="{StaticResource Bg.Border}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Separator">
            <Border Height="1" Background="{TemplateBinding Background}" Margin="8,4"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ================= toolbar / statusbar ================= -->
    <Style TargetType="ToolBarTray">
      <Setter Property="Background" Value="{StaticResource Bg.Panel}"/>
    </Style>
    <Style TargetType="ToolBar">
      <Setter Property="Background" Value="{StaticResource Bg.Panel}"/>
      <Setter Property="Foreground" Value="{StaticResource Fg.Text}"/>
    </Style>
    <Style TargetType="StatusBar">
      <Setter Property="Background" Value="{StaticResource Bg.Panel}"/>
      <Setter Property="Foreground" Value="{StaticResource Fg.Muted}"/>
    </Style>

    <!-- ================= buttons ================= -->
    <Style TargetType="Button">
      <Setter Property="Background" Value="{StaticResource Bg.Button}"/>
      <Setter Property="Foreground" Value="{StaticResource Fg.Text}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Bg.Border}"/>
      <Setter Property="Padding" Value="8,3"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{StaticResource Bg.ButtonHover}"/>
        </Trigger>
        <Trigger Property="IsPressed" Value="True">
          <Setter Property="Background" Value="{StaticResource Bg.Selected}"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- ================= text boxes ================= -->
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="{StaticResource Bg.Editor}"/>
      <Setter Property="Foreground" Value="{StaticResource Fg.Text}"/>
      <Setter Property="CaretBrush" Value="{StaticResource Fg.Text}"/>
      <Setter Property="SelectionBrush" Value="{StaticResource Bg.Selected}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Bg.Border}"/>
    </Style>

    <!-- ================= tabs ================= -->
    <Style TargetType="TabControl">
      <Setter Property="Background" Value="{StaticResource Bg.Editor}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Bg.Border}"/>
      <Setter Property="Foreground" Value="{StaticResource Fg.Text}"/>
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="Bd"
                    Background="{StaticResource Bg.Tab}"
                    BorderBrush="{StaticResource Bg.Border}"
                    BorderThickness="1,1,1,0"
                    Padding="12,5" Margin="0,3,0,0"
                    CornerRadius="2,2,0,0">
              <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Bg.Editor}"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Bg.Border}"/>
              </Trigger>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="IsMouseOver" Value="True"/>
                  <Condition Property="IsSelected" Value="False"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Bg.Hover}"/>
              </MultiTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ================= tree view ================= -->
    <Style TargetType="TreeView">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource Fg.Text}"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style TargetType="TreeViewItem">
      <Setter Property="Foreground" Value="{StaticResource Fg.Text}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TreeViewItem">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <Border x:Name="Bd" Background="Transparent" Padding="2,2" CornerRadius="2" Margin="0,1,4,1">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <ToggleButton x:Name="Expander" Width="16" Height="16"
                                Background="Transparent" BorderThickness="0"
                                IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                ClickMode="Press">
                    <ToggleButton.Template>
                      <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent">
                          <Path x:Name="Arrow" Data="M 3,1 L 9,6 L 3,11 Z"
                                Fill="{StaticResource Fg.Muted}"
                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Arrow" Property="Data" Value="M 1,3 L 6,9 L 11,3 Z"/>
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </ToggleButton.Template>
                  </ToggleButton>
                  <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center"/>
                </Grid>
              </Border>
              <ItemsPresenter Grid.Row="1" x:Name="ItemsHost" Margin="16,0,0,0"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsExpanded" Value="False">
                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
              </Trigger>
              <Trigger Property="HasItems" Value="False">
                <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Bg.Selected}"/>
              </Trigger>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="IsMouseOver" Value="True"/>
                  <Condition Property="IsSelected" Value="False"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Bg.Hover}"/>
              </MultiTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ================= lists ================= -->
    <Style TargetType="ListView">
      <Setter Property="Background" Value="{StaticResource Bg.Editor}"/>
      <Setter Property="Foreground" Value="{StaticResource Fg.Text}"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style TargetType="GridViewColumnHeader">
      <Setter Property="Background" Value="{StaticResource Bg.Panel}"/>
      <Setter Property="Foreground" Value="{StaticResource Fg.Muted}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Bg.Border}"/>
      <Setter Property="Padding" Value="6,4"/>
    </Style>
    <Style TargetType="ListViewItem">
      <Setter Property="Foreground" Value="{StaticResource Fg.Text}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="{StaticResource Bg.Selected}"/>
          <Setter Property="Foreground" Value="White"/>
        </Trigger>
      </Style.Triggers>
    </Style>

  </Application.Resources>
</Application>
