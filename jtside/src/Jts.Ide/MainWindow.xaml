<Window x:Class="JtsIde.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JTS IDE"
        Width="1200" Height="780"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg.Window}">
  <DockPanel>

    <!-- Menu -->
    <Menu DockPanel.Dock="Top" Padding="2,0">
      <MenuItem Header="_File">
        <MenuItem Header="_New File" Click="OnNewFile" InputGestureText="Ctrl+N"/>
        <MenuItem Header="_Open File..." Click="OnOpenFile" InputGestureText="Ctrl+O"/>
        <MenuItem Header="Open _Folder..." Click="OnOpenFolder"/>
        <Separator/>
        <MenuItem Header="_Save" Click="OnSave" InputGestureText="Ctrl+S"/>
        <MenuItem Header="Save _As..." Click="OnSaveAs"/>
        <Separator/>
        <MenuItem Header="Close Tab" Click="OnCloseTab" InputGestureText="Ctrl+W"/>
        <MenuItem Header="E_xit" Click="OnExit"/>
      </MenuItem>
      <MenuItem Header="_Edit">
        <MenuItem Header="_Undo" Click="OnUndo" InputGestureText="Ctrl+Z"/>
        <MenuItem Header="_Redo" Click="OnRedo" InputGestureText="Ctrl+Y"/>
        <Separator/>
        <MenuItem Header="Cu_t" Click="OnCut" InputGestureText="Ctrl+X"/>
        <MenuItem Header="_Copy" Click="OnCopy" InputGestureText="Ctrl+C"/>
        <MenuItem Header="_Paste" Click="OnPaste" InputGestureText="Ctrl+V"/>
        <MenuItem Header="Select _All" Click="OnSelectAll" InputGestureText="Ctrl+A"/>
      </MenuItem>
      <MenuItem Header="_Run">
        <MenuItem Header="_Run Program" Click="OnRun" InputGestureText="F5"/>
        <MenuItem Header="_Build Bytecode" Click="OnBuild" InputGestureText="F6"/>
        <MenuItem Header="Sto_p" Click="OnStop"/>
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="About JTS IDE" Click="OnAbout"/>
      </MenuItem>
    </Menu>

    <!-- Toolbar -->
    <ToolBarTray DockPanel.Dock="Top">
      <ToolBar Padding="4,2">
        <Button Click="OnRun" ToolTip="Run program (F5)" Margin="0,0,4,0">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="▶ " Foreground="#4CAF50"/>
            <TextBlock Text="Run" FontWeight="Bold"/>
          </StackPanel>
        </Button>
        <Button Click="OnBuild" ToolTip="Compile to bytecode (F6)" Margin="0,0,4,0">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="⇧ " Foreground="#569CD6"/>
            <TextBlock Text="Build"/>
          </StackPanel>
        </Button>
        <Button Click="OnStop" ToolTip="Stop the running program" Margin="0,0,4,0">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="■ " Foreground="#EF5350"/>
            <TextBlock Text="Stop"/>
          </StackPanel>
        </Button>
        <Separator/>
        <Button Click="OnNewFile" ToolTip="New file" Margin="0,0,4,0"><TextBlock Text="New"/></Button>
        <Button Click="OnOpenFile" ToolTip="Open file" Margin="0,0,4,0"><TextBlock Text="Open"/></Button>
        <Button Click="OnSave" ToolTip="Save (Ctrl+S)" Margin="0,0,4,0"><TextBlock Text="Save"/></Button>
      </ToolBar>
    </ToolBarTray>

    <!-- Status bar -->
    <StatusBar DockPanel.Dock="Bottom">
      <StatusBarItem>
        <TextBlock Name="StatusText" Text="Ready" TextTrimming="CharacterEllipsis"/>
      </StatusBarItem>
      <Separator/>
      <StatusBarItem>
        <TextBlock Name="ToolchainText"/>
      </StatusBarItem>
      <Separator/>
      <StatusBarItem HorizontalAlignment="Right">
        <TextBlock Name="CaretText" Text="Ln 1, Col 1"/>
      </StatusBarItem>
    </StatusBar>

    <!-- Workspace -->
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="230" MinWidth="140"/>
        <ColumnDefinition Width="4"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Explorer -->
      <Border Grid.Column="0" Background="{StaticResource Bg.Panel}"
              BorderBrush="{StaticResource Bg.Border}" BorderThickness="0,0,1,0">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Margin="10,8,10,6">
            <TextBlock Text="EXPLORER" FontSize="11" Foreground="{StaticResource Fg.Muted}" FontWeight="Bold"/>
            <Grid Margin="0,8,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBox Name="FolderPathBox" Height="24" VerticalContentAlignment="Center" FontSize="12"/>
              <Button Grid.Column="1" Content="..." Click="OnBrowseFolder"
                      Margin="4,0,0,0" Width="30" Height="24" ToolTip="Choose folder"/>
            </Grid>
          </StackPanel>
          <TreeView Name="FileTree" Margin="8,0,8,8"
                    MouseDoubleClick="OnTreeDoubleClick"/>
        </DockPanel>
      </Border>

      <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="{StaticResource Bg.Border}"/>

      <!-- Editor + Console -->
      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="4"/>
          <RowDefinition Height="180" MinHeight="90"/>
        </Grid.RowDefinitions>

        <TabControl Name="EditorTabs" Grid.Row="0">
        </TabControl>

        <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" Background="{StaticResource Bg.Border}"/>

        <TabControl Grid.Row="2" Name="ConsoleTabs">
          <TabItem Header="Output">
            <TextBox Name="OutputBox" IsReadOnly="True"
                     FontFamily="Consolas" FontSize="12"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     TextWrapping="NoWrap" BorderThickness="0"/>
          </TabItem>
          <TabItem Header="Errors">
            <ListView Name="ErrorList" FontFamily="Consolas" FontSize="12"
                      MouseDoubleClick="OnErrorDoubleClick">
              <ListView.View>
                <GridView>
                  <GridViewColumn Header="Line" Width="55" DisplayMemberBinding="{Binding Line}"/>
                  <GridViewColumn Header="Type" Width="80" DisplayMemberBinding="{Binding Kind}"/>
                  <GridViewColumn Header="Message" Width="700" DisplayMemberBinding="{Binding Message}"/>
                </GridView>
              </ListView.View>
            </ListView>
          </TabItem>
          <TabItem Header="Console">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <DockPanel Grid.Row="0" Background="{StaticResource Bg.Panel}" Margin="0,0,0,1">
                <Button DockPanel.Dock="Right" Content="Restart" Click="OnReplRestart"
                        Margin="2" Padding="8,1" ToolTip="Restart the interactive console"/>
                <TextBlock Text="Interactive JTS GO REPL — state persists between lines. Type exit to quit."
                           Foreground="{StaticResource Fg.Muted}" FontSize="11"
                           VerticalAlignment="Center" Margin="6,3"/>
              </DockPanel>
              <TextBox Grid.Row="1" Name="ReplOutputBox" IsReadOnly="True"
                       FontFamily="Consolas" FontSize="12"
                       VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                       TextWrapping="NoWrap" BorderThickness="0"/>
              <DockPanel Grid.Row="2" Margin="0,1,0,0">
                <TextBlock DockPanel.Dock="Left" Text="jts> " FontFamily="Consolas" FontSize="12"
                           Foreground="{StaticResource Fg.Muted}" VerticalAlignment="Center"/>
                <TextBox Name="ReplInputBox" Height="24" FontFamily="Consolas" FontSize="12"
                         VerticalContentAlignment="Center" KeyDown="OnReplInputKeyDown"/>
              </DockPanel>
            </Grid>
          </TabItem>
        </TabControl>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
