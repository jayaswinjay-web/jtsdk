# List literal
nums = [1, 2, 3, 4, 5]
say(nums)

# Indexing
say(nums[0])
say(nums[2])

# Length
say(len(nums))

# Append
append(nums, 6)
say(nums)

# Index assignment
nums[0] = 99
say(nums)

# Type
say(type(nums))

# Empty list
empty = []
say(empty)

# Mixed types
mixed = ["hello", 42, true]
say(mixed)

# For loop over list
for i of 0 to len(mixed)
    say(mixed[i])
end
