# Minimal LLM in JTS GO
# A character-level trigram language model. It learns
# P(next char | previous two chars) from a small corpus and then
# generates new text by sampling from the learned distribution.
#
# contexts[i]      -> 2-char context string
# nexts[i]         -> list of chars that followed contexts[i]
# freqs[i]         -> matching counts for nexts[i]

corpus = "the quick brown fox jumps over the lazy dog. the quick brown fox leaps over the lazy dog. jts go is fun. jts go makes programming easy. the quick fox is fast and clever."

contexts = []
nexts = []
freqs = []

# ---------- learn ----------
ctx = "  "
for i in 0 to len(corpus)
    c = substring(corpus, i, i + 1)

    ci = -1
    for j in 0 to len(contexts)
        if contexts[j] == ctx
            ci = j
        end
    end
    if ci == -1
        append(contexts, ctx)
        append(nexts, [])
        append(freqs, [])
        ci = len(contexts) - 1
    end

    ni = -1
    for j in 0 to len(nexts[ci])
        if nexts[ci][j] == c
            ni = j
        end
    end
    if ni == -1
        append(nexts[ci], c)
        append(freqs[ci], 1)
    else
        freqs[ci][ni] = freqs[ci][ni] + 1
    end

    ctx = substring(ctx, 1, 2) + c
end

print("learned " + len(contexts) + " contexts")

# ---------- helpers ----------
func find_context(ctx)
    for j in 0 to len(contexts)
        if contexts[j] == ctx
            return j
        end
    end
    return -1
end

func sample(ci)
    total = 0
    for j in 0 to len(freqs[ci])
        total = total + freqs[ci][j]
    end
    r = rand() * total
    acc = 0
    for j in 0 to len(freqs[ci])
        acc = acc + freqs[ci][j]
        if r < acc
            return nexts[ci][j]
        end
    end
    return nexts[ci][0]
end

# ---------- generate ----------
seed(7)
ctx = "  "
out = ""
for i in 0 to 200
    ci = find_context(ctx)
    c = " "
    if ci != -1
        c = sample(ci)
    end
    out = out + c
    ctx = substring(ctx, 1, 2) + c
end

print(out)
