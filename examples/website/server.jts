# =============================================================================
#  JTS GO Full-Stack Website Server
#  A complete website served entirely by JTS GO.
#  Uses http_server + http_route (added in v2.1.10).
# =============================================================================

print("Loading website assets...")

# ---- Read all static files from disk once at startup ----
home_html = read_file("public/index.html")
about_html = read_file("public/about.html")
projects_html = read_file("public/projects.html")
contact_html = read_file("public/contact.html")
style_css = read_file("public/style.css")
app_js = read_file("public/app.js")

# ---- JSON API data ----
projects_json = read_file("data/projects.json")
skills_json = '{"skills": ["JTS GO", "C", "Algorithms", "Web", "ML", "Data Structures"]}'
about_json = '{"name": "Jay Tech Solutions", "founded": 2024, "mission": "The easiest programming language to learn."}'

print("All assets loaded.")

# ---- Create the HTTP server ----
srv = http_server(8080)

# ---- HTML pages ----
http_route(srv, "GET", "/", home_html)
http_route(srv, "GET", "/index.html", home_html)
http_route(srv, "GET", "/about", about_html)
http_route(srv, "GET", "/projects", projects_html)
http_route(srv, "GET", "/contact", contact_html)

# ---- Static assets ----
http_route(srv, "GET", "/style.css", style_css)
http_route(srv, "GET", "/app.js", app_js)

# ---- JSON API endpoints ----
http_route(srv, "GET", "/api/projects", projects_json)
http_route(srv, "GET", "/api/skills", skills_json)
http_route(srv, "GET", "/api/about", about_json)

print("Routes registered.")
print("Visit http://localhost:8080")
print("API: /api/projects  /api/skills  /api/about")
print("")
http_start(srv)
