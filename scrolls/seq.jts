# seq scroll - sequence/list utilities
func head(lst)
    if len(lst) == 0
        return nil
    end
    return lst[0]
end

func tail(lst)
    out = []
    i = 1
    while i < len(lst)
        out.append(lst[i])
        i = i + 1
    end
    return out
end

func init(lst)
    out = []
    i = 0
    while i < len(lst) - 1
        out.append(lst[i])
        i = i + 1
    end
    return out
end

func last_item(lst)
    n = len(lst)
    if n == 0
        return nil
    end
    return lst[n - 1]
end

func take(lst, n)
    out = []
    i = 0
    while i < n and i < len(lst)
        out.append(lst[i])
        i = i + 1
    end
    return out
end

func drop(lst, n)
    out = []
    i = n
    while i < len(lst)
        out.append(lst[i])
        i = i + 1
    end
    return out
end

func nth(lst, i)
    n = len(lst)
    if i < 0
        i = n + i
    end
    if i < 0 or i >= n
        return nil
    end
    return lst[i]
end

func zip(a, b)
    out = []
    n = min(len(a), len(b))
    i = 0
    while i < n
        out.append([a[i], b[i]])
        i = i + 1
    end
    return out
end

func enumerate(lst)
    out = []
    i = 0
    while i < len(lst)
        out.append([i, lst[i]])
        i = i + 1
    end
    return out
end

func interleave(a, b)
    out = []
    n = max(len(a), len(b))
    i = 0
    while i < n
        if i < len(a)
            out.append(a[i])
        end
        if i < len(b)
            out.append(b[i])
        end
        i = i + 1
    end
    return out
end

func sliding_window(lst, n)
    out = []
    if n <= 0
        return out
    end
    i = 0
    while i + n <= len(lst)
        win = []
        j = 0
        while j < n
            win.append(lst[i + j])
            j = j + 1
        end
        out.append(win)
        i = i + 1
    end
    return out
end

func consecutive_pairs(lst)
    out = []
    i = 0
    while i < len(lst) - 1
        out.append([lst[i], lst[i + 1]])
        i = i + 1
    end
    return out
end

func product(a, b)
    out = []
    for x in a
        for y in b
            out.append([x, y])
        end
    end
    return out
end

func frequency(lst)
    out = []
    for item in lst
        found = -1
        i = 0
        while i < len(out)
            if out[i][0] == item
                found = i
                break
            end
            i = i + 1
        end
        if found >= 0
            pair = out[found]
            out[found] = [pair[0], pair[1] + 1]
        else
            out.append([item, 1])
        end
    end
    return out
end

func repeat_times(lst, n)
    out = []
    i = 0
    while i < n
        out.extend(lst)
        i = i + 1
    end
    return out
end

func cycle(lst, n)
    out = []
    if len(lst) == 0
        return out
    end
    i = 0
    while i < n
        out.append(lst[i % len(lst)])
        i = i + 1
    end
    return out
end

func shuffle_copy(lst)
    c = lst.copy()
    shuffle(c)
    return c
end

func accumulate(lst)
    out = []
    total = 0
    for x in lst
        total = total + x
        out.append(total)
    end
    return out
end

func differences(lst)
    out = []
    i = 1
    while i < len(lst)
        out.append(lst[i] - lst[i - 1])
        i = i + 1
    end
    return out
end

func intersperse(lst, sep)
    out = []
    i = 0
    while i < len(lst)
        if i > 0
            out.append(sep)
        end
        out.append(lst[i])
        i = i + 1
    end
    return out
end
