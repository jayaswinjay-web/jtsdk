# strings scroll - string utilities
func reverse(s)
    out = ""
    i = len(s) - 1
    while i >= 0
        out = out + s[i]
        i = i - 1
    end
    return out
end

func is_palindrome(s)
    return s == reverse(s)
end

func count_words(s)
    words = s.split(" ")
    count = 0
    for w of words
        if w != ""
            count = count + 1
        end
    end
    return count
end

func repeat(s, n)
    out = ""
    i = 0
    while i < n
        out = out + s
        i = i + 1
    end
    return out
end

func truncate(s, n)
    if len(s) <= n
        return s
    end
    return s.substring(0, n - 3) + "..."
end

func capitalize_words(s)
    words = s.split(" ")
    out = ""
    first = true
    for w of words
        if w == ""
            continue
        end
        if not first
            out = out + " "
        end
        out = out + w[0].upper() + w.substring(1, len(w) - 1).lower()
        first = false
    end
    return out
end

func strip_vowels(s)
    out = ""
    for c of s
        lower = c.lower()
        if lower != "a" and lower != "e" and lower != "i" and lower != "o" and lower != "u"
            out = out + c
        end
    end
    return out
end

func remove_spaces(s)
    out = ""
    for c of s
        if c != " "
            out = out + c
        end
    end
    return out
end

func words(s)
    return s.split(" ")
end

func has_letter(s, ch)
    return s.contains(ch)
end

func titleize(s)
    return capitalize_words(s)
end

